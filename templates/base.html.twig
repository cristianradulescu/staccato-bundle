<!DOCTYPE html>
<html lang="{{ staccato.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ siteTitle }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ staccato.description }}{% endblock %}">
    {% block canonical %}{% endblock %}
    {% block social_meta %}
    <meta property="og:site_name" content="{{ siteTitle }}">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:title" content="{% block og_title %}{{ siteTitle }}{% endblock %}">
    <meta property="og:description" content="{{ block('description') }}">
    {% block og_meta %}{% endblock %}
    <meta name="twitter:card" content="summary">
    {% endblock %}
    <link rel="alternate" type="application/rss+xml" title="{{ siteTitle }}" href="{{ staccato_url('/rss.xml') }}">
    {% if includeDefaultStyles %}
    <link rel="stylesheet" href="{{ staccato_path('/assets/staccato/staccato.css') }}">
    {% endif %}
    {% if includeHighlighterStyles %}
    <link rel="stylesheet" href="{{ staccato_path('/assets/staccato/highlighter.css') }}">
    {% endif %}
    {% for stylesheet in stylesheets %}
    <link rel="stylesheet" href="{{ staccato_path('/assets/staccato/' ~ stylesheet) }}">
    {% endfor %}
    {% block head_extra %}{% endblock %}
</head>
<body>
    {% block header %}
    <header class="site-header">
        <div class="site-container site-header-inner">
            {% block site_title %}
            <a class="site-title" href="{{ staccato_path('/') }}">{{ siteTitle }}</a>
            {% endblock %}
            {% block nav %}{% endblock %}
        </div>
    </header>
    {% endblock %}

    <main class="site-main">
        <div class="site-container">
            {% block content %}{% endblock %}
        </div>
    </main>

    {% block footer %}
    <footer class="site-footer">
        <div class="site-container">
            {% block footer_content %}
            <p>{{ footerText }}</p>
            {% endblock %}
        </div>
    </footer>
    {% endblock %}
</body>
</html>
