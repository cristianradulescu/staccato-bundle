<!DOCTYPE html>
<html lang="{{ staccato.language }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ siteTitle }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ staccato.description }}{% endblock %}">
    {% block canonical %}{% endblock %}
    <link rel="alternate" type="application/rss+xml" title="{{ siteTitle }}" href="{{ staccato_url('/rss.xml') }}">
    {% if includeDefaultStyles %}
    <link rel="stylesheet" href="{{ staccato_path('/assets/staccato/staccato.css') }}">
    {% endif %}
    {% if includeHighlighterStyles %}
    <link rel="stylesheet" href="{{ staccato_path('/assets/staccato/highlighter.css') }}">
    {% endif %}
    {% for stylesheet in stylesheets %}
    <link rel="stylesheet" href="{{ staccato_path('/assets/staccato/' ~ stylesheet) }}">
    {% endfor %}
</head>
<body>
    <header class="site-header">
        <div class="site-container">
            <a class="site-title" href="{{ staccato_path('/') }}">{{ siteTitle }}</a>
        </div>
    </header>

    <main class="site-main">
        <div class="site-container">
            {% block content %}{% endblock %}
        </div>
    </main>

    <footer class="site-footer">
        <div class="site-container">
            <p>{{ footerText }}</p>
        </div>
    </footer>
</body>
</html>
