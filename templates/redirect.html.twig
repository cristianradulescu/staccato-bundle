{#-
    Contract: besides the staccato global and the staccato_url()/staccato_path() functions, this template reads only
    page.title and page.urlPath (the page redirected to). It may be rendered with any object or array providing them,
    e.g. from a SiteBuiltEvent listener writing redirects that are not page aliases, so do not read anything else.
-#}
<!DOCTYPE html>
<html lang="{{ staccato.language }}">
<head>
    <meta charset="UTF-8">
    <title>{{ page.title }} · {{ staccato.title }}</title>
    <link rel="canonical" href="{{ staccato_url(page.urlPath) }}">
    <meta name="robots" content="noindex">
    <meta http-equiv="refresh" content="0; url={{ staccato_path(page.urlPath) }}">
</head>
<body>
    <p>This page has moved to <a href="{{ staccato_path(page.urlPath) }}">{{ page.title }}</a>.</p>
</body>
</html>
