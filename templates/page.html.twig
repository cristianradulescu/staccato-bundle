{% extends '@Staccato/base.html.twig' %}

{% block title %}{{ page.title }} · {{ siteTitle }}{% endblock %}

{% block description %}{{ page.excerpt ?: staccato.description }}{% endblock %}

{% block canonical %}
<link rel="canonical" href="{{ staccato_url(page.urlPath) }}">
{% endblock %}

{% block og_type %}{{ page.publishedAt ? 'article' : 'website' }}{% endblock %}

{% block og_title %}{{ page.title }}{% endblock %}

{% block og_meta %}
<meta property="og:url" content="{{ staccato_url(page.urlPath) }}">
{% if page.publishedAt %}
<meta property="article:published_time" content="{{ page.publishedAt|date('c') }}">
{% endif %}
{% endblock %}

{% block content %}
    <article class="page">
        <h1 class="page-title">{{ page.title }}</h1>
        {% if page.publishedAt %}
            <p class="page-meta">{{ page.publishedAt|date('F j, Y') }}</p>
        {% endif %}
        <div class="prose">
            {{ page.html|raw }}
        </div>
    </article>
{% endblock %}
