{
    "name": "cristianradulescu/staccato-bundle",
    "description": "Symfony bundle that turns Markdown content into a static site.",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/cristianradulescu/staccato-bundle",
    "support": {
        "issues": "https://github.com/cristianradulescu/staccato-bundle/issues",
        "source": "https://github.com/cristianradulescu/staccato-bundle"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "fakerphp/faker": "^1.24",
        "league/commonmark": "^2.8",
        "symfony/config": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dependency-injection": "8.1.*",
        "symfony/filesystem": "8.1.*",
        "symfony/finder": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/twig": "^3.14"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "suggest": {
        "symfony/twig-bundle": "Required to render Staccato's default templates and to allow per-template overrides in your app."
    },
    "autoload": {
        "psr-4": {
            "Staccato\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Staccato\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "qa": [
            "@cs:check",
            "@stan",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.1",
        "symfony/framework-bundle": "8.1.*",
        "symfony/twig-bundle": "8.1.*"
    }
}
