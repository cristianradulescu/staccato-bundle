{
    "name": "cristianradulescu/staccato-bundle",
    "description": "Symfony bundle that turns Markdown content into a static site.",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/cristianradulescu/staccato-bundle",
    "support": {
        "issues": "https://github.com/cristianradulescu/staccato-bundle/issues",
        "source": "https://github.com/cristianradulescu/staccato-bundle"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/http-foundation": "^8.1.7",
        "symfony/http-kernel": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/yaml": "^8.1.6",
        "tempest/highlight": "^2.29",
        "tempest/markdown": "^1.1",
        "twig/twig": "^3.14"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "suggest": {
        "fakerphp/faker": "Required for the site:build --use-fixtures option, which generates demo articles."
    },
    "autoload": {
        "psr-4": {
            "Staccato\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Staccato\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "qa": [
            "@cs:check",
            "@stan",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.1",
        "symfony/framework-bundle": "^8.1"
    }
}
